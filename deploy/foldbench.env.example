# Copy to /etc/foldbench.env; restrict access; replace every installation value.
FOLDBENCH_API_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
FOLDBENCH_MODE=simulation
FOLDBENCH_DATA=/var/lib/foldbench
FOLDBENCH_CALIBRATION=/etc/foldbench-calibration.json
FOLDBENCH_PORT=/dev/serial/by-id/REPLACE_WITH_U2D2_ID
FOLDBENCH_GPIO=/dev/gpiochip0
FOLDBENCH_CASE_PROBE=/sys/bus/w1/devices/28-REPLACE_CASE/w1_slave
FOLDBENCH_AMBIENT_PROBE=/sys/bus/w1/devices/28-REPLACE_AMBIENT/w1_slave
FOLDBENCH_HOST=127.0.0.1
FOLDBENCH_HTTP_PORT=8000
# For private-LAN TLS service, set a specific LAN bind IP and certificate paths:
# FOLDBENCH_TLS_CERT=/etc/foldbench/server.crt
# FOLDBENCH_TLS_KEY=/etc/foldbench/server.key
