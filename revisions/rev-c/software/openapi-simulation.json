    "/v1/runs/{run_id}/{action}": {
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "Run Action",
        "description": "Pause at the next open endpoint after a full cycle.\n\nStop ends the run immediately without counting a partial cycle.\nResume is valid only for a healthy paused run at the open endpoint.",
        "operationId": "run_action_v1_runs__run_id___action__post",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "action",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "pause",
                "resume",
                "stop"
              ],
              "type": "string",
              "title": "Action"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
