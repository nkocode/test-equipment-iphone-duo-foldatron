{
  "openapi": "3.1.0",
  "info": {
    "title": "foldatron Rev C",
    "description": "Catalog-component folding bench. Simulation is default. Use one worker. Hardware requires a local commissioning record. Opening is an endpoint-calibrated motor estimate, not direct phone-angle or torque measurement. API stop is not the physical E-stop. Vacuum release and safety reset are physical operations.",
    "version": "0.3.0"
  },
