            "type": "boolean",
            "title": "Full Closure Verified",
            "default": false
          },
          "vacuum_loss_tested": {
            "type": "boolean",
            "title": "Vacuum Loss Tested",
            "default": false
          },
          "stop_circuit_tested": {
            "type": "boolean",
            "title": "Stop Circuit Tested",
            "default": false
          },
          "hose_sweep_tested": {
            "type": "boolean",
            "title": "Hose Sweep Tested",
            "default": false
          },
          "load_limit_tested": {
            "type": "boolean",
            "title": "Load Limit Tested",
            "default": false
          }
        },
